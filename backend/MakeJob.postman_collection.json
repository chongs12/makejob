    {
      "name": "认证",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"postman_user\",\"email\":\"{{user_email}}\",\"password\":\"{{user_password}}\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "response": []
        },
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('用户登录成功', function () { pm.expect(json.code).to.eql(0); pm.expect(json.data.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('user_token', json.data.token || '');",
                  "pm.collectionVariables.set('bearer_token', json.data.token || '');",
                  "pm.collectionVariables.set('user_refresh_token', json.data.refresh_token || '');",
                  "pm.collectionVariables.set('refresh_token', json.data.refresh_token || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{user_email}}\",\"password\":\"{{user_password}}\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "刷新用户 Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  pm.collectionVariables.set('user_token', json.data.token || '');",
                  "  pm.collectionVariables.set('bearer_token', json.data.token || '');",
                  "  pm.collectionVariables.set('user_refresh_token', json.data.refresh_token || '');",
                  "  pm.collectionVariables.set('refresh_token', json.data.refresh_token || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refresh_token\":\"{{refresh_token}}\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/refresh"
          },
          "response": []
        },
        {
          "name": "当前用户信息",
          "request": {
            "header": [{ "key": "Authorization", "value": "Bearer {{bearer_token}}" }],
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "response": []
        },
        {
          "name": "获取用户资料",
          "request": {
            "header": [{ "key": "Authorization", "value": "Bearer {{bearer_token}}" }],
            "method": "GET",
            "url": "{{baseUrl}}/api/user/profile"
          },
          "response": []
        },
        {
          "name": "管理员登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('管理员登录成功', function () { pm.expect(json.code).to.eql(0); pm.expect(json.data.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('admin_token', json.data.token || '');",
                  "pm.collectionVariables.set('admin_bearer_token', json.data.token || '');",
                  "pm.collectionVariables.set('admin_refresh_token', json.data.refresh_token || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{admin_email}}\",\"password\":\"{{admin_password}}\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "刷新管理员 Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  pm.collectionVariables.set('admin_token', json.data.token || '');",
                  "  pm.collectionVariables.set('admin_bearer_token', json.data.token || '');",
                  "  pm.collectionVariables.set('admin_refresh_token', json.data.refresh_token || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refresh_token\":\"{{admin_refresh_token}}\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/refresh"
          },
          "response": []
        }
      ]
