{
  "name": "makejob-frontend-react",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @makejob/web",
    "dev:admin": "npm run dev -w @makejob/admin",
    "build:web": "npm run build -w @makejob/web",
    "build:admin": "npm run build -w @makejob/admin",
    "build": "npm run build:web && npm run build:admin",
    "preview:web": "npm run preview -w @makejob/web",
    "preview:admin": "npm run preview -w @makejob/admin"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
